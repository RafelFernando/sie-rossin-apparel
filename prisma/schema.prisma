// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Transaksis {
  id                     String   @id @default(cuid())
  customerId             String
  transactionDate        DateTime
  productCategory        String
  unitPrice              Int
  quantity               Int
  totalAmount            Int
  discountAmount         Int
  paymentMethod          String
  deviceType             String
  sessionDurationMinutes Int
  pagesViewed            Int
  isReturningCustomer    String
  customerRating         Int
  createdAt              DateTime @default(now())
}

model User {
  id       String  @id @default(cuid())
  name     String?
  email    String? @unique
  password String?
  role     String  @default("user")
}

enum SubmissionStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

model CreditSubmission {
  id                 String           @id @default(cuid())
  submissionNumber   String           @unique

  // Data konsumen
  customerName       String
  nik                String

  // Data kendaraan
  dealerName         String
  vehicleBrand       String
  vehicleModel       String
  vehiclePrice       Decimal          @db.Decimal(15, 2)
  downPayment        Decimal          @db.Decimal(15, 2)

  // Data pinjaman
  tenorMonths        Int
  monthlyInstallment Decimal          @db.Decimal(15, 2)

  // Pengajuan dan approval
  notes              String?          @db.Text
  status             SubmissionStatus @default(SUBMITTED)
  approvalNote       String?          @db.Text
  approvedBy         String?
  approvedAt         DateTime?

  // Timestamp
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([customerName])
}
